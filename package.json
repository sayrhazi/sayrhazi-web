{
  "name": "sayrhazi-web",
  "version": "0.1.0",
  "private": true,
  "description": "Site vitrine statique du système agentic Sayrhazi",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "sync": "node scripts/sync-noyau.cjs",
    "predev": "node scripts/sync-noyau.cjs",
    "prebuild": "node scripts/sync-noyau.cjs",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node -e \"const fs=require('fs'); fs.copyFileSync('dist/index.html','dist/404.html');\"",
    "preview": "vite preview --port 5175",
    "lint": "tsc --noEmit",
    "test": "node -e \"console.log('Site statique Sayrhazi-web : aucun test unitaire ; verification par yarn build et relecture.')\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
